# NeuroPortal Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/neuroportal

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS) - can be a single URL or comma-separated list of deployed frontend URLs
# Examples:
#   CLIENT_URL=http://localhost:5173
#   CLIENT_URL=https://my-frontend.vercel.app
#   CLIENT_URL=https://my-frontend.netlify.app,https://my-custom-domain.com
CLIENT_URL=http://localhost:5173,http://localhost:3000
